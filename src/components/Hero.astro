---
import { Image } from 'astro:assets';
import producto1 from '../assets/producto_1.png';

const linkMercadoLibre = "https://articulo.mercadolibre.cl/MLC-2932383734-nucleovital-_JM?has_official_store=false&highlight=false&headerTopBrand=false#polycard_client=search-nordic&search_layout=stack&position=8&type=item&tracking_id=e5ab2676-358d-4654-bf3f-7de7600f3dcd&wid=MLC2932383734&sid=search";
---
<section id="inicio" class="relative bg-linear-to-br from-red-50 to-yellow-50 py-20 overflow-hidden">
  <div class="container mx-auto px-4 grid lg:grid-cols-2 gap-12 items-center">
    
    <div class="space-y-8 relative z-20">
      <span class="inline-block py-1.5 px-4 rounded-full bg-red-100 text-red-700 text-sm font-bold tracking-wide border border-red-200 shadow-sm">
        🏆 Calidad Farmacéutica Comprobada
      </span>

      <h1 class="text-5xl lg:text-6xl font-extrabold text-slate-800 leading-[1.1]">
        Recupera tu energía y <span class="text-transparent bg-clip-text bg-linear-to-r from-red-600 to-yellow-600">fortalece tu salud.</span>
      </h1>
      
      <p class="text-xl text-slate-600 leading-relaxed max-w-lg font-medium">
        Combate la fatiga diaria con la concentración exacta de <strong class="text-slate-800">Magnesio, Zinc y Vitaminas</strong>. El escudo que tu sistema inmunológico necesita hoy.
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a href={linkMercadoLibre} target="_blank" rel="noopener noreferrer" class="group flex items-center justify-center gap-2 bg-linear-to-r from-yellow-400 to-yellow-500 hover:from-yellow-500 hover:to-yellow-600 text-slate-900 px-8 py-4 text-lg font-bold rounded-full shadow-[0_8px_20px_-6px_rgba(234,179,8,0.5)] transform hover:-translate-y-1 transition-all duration-200">
          Comprar en Mercado Libre
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
        <a href="#contacto" class="flex items-center justify-center px-8 py-4 text-lg font-semibold text-slate-700 hover:text-red-600 hover:bg-red-50 rounded-full transition-colors">
          Consultar a un asesor
        </a>
      </div>

      <div class="flex items-center gap-4 mt-8 bg-white/80 backdrop-blur-sm w-fit px-5 py-3 rounded-2xl border border-slate-200 shadow-sm">
        <div class="flex text-yellow-500 text-xl">★★★★★</div>
        <p class="text-sm text-slate-700 leading-tight">
          <span class="font-bold text-slate-900">100% Calificaciones positivas</span><br/>
          Con envío seguro a todo Chile
        </p>
      </div>
    </div>

    <div class="relative z-10 flex justify-center lg:justify-end">
      <div class="absolute inset-0 bg-linear-to-tr from-yellow-300/40 to-red-400/40 rounded-full blur-3xl -z-10 transform scale-90"></div>
      <Image src={producto1} alt="Nucleovital Multivitamínico en Chile" class="w-full max-w-lg drop-shadow-[0_25px_35px_rgba(0,0,0,0.2)] hover:scale-105 transition-transform duration-500" />
    </div>
    
  </div>
</section>