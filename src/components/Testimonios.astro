---
const testimonios = [
  { name: "María González", age: "45 años, Santiago de Chile", text: "Desde que tomo el multivitamínico Nucleovital mi bienestar ha mejorado. Siento que las vitaminas me dan más energía y mi salud es más fuerte. ¡Lo recomiendo!" },
  { name: "Carlos Rodríguez", age: "52 años, Concepción, Chile", text: "Excelente producto. He notado una mejora en mi salud gracias a su fórmula con Magnesio y Zinc. Muy satisfecho con Nucleovital." },
  { name: "Ana Martínez", age: "38 años, Valparaíso, Chile", text: "Nucleovital me ha ayudado a mantener mi salud en óptimas condiciones. Agradezco que sea un producto con Colágeno y Calcio de calidad farmacéutica." }
];
---
<section id="testimonios" class="py-20 bg-white">
  <div class="container mx-auto px-4">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold text-gray-800 mb-4">Testimonios de Nucleovital</h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">Personas en todo Chile ya experimentan los beneficios de las vitaminas y minerales.</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Video de YouTube original -->
      <div class="bg-gradient-to-br from-red-50 to-yellow-50 rounded-2xl p-4 shadow-lg flex flex-col justify-between">
        <div class="aspect-video w-full mb-4 rounded-lg overflow-hidden">
          <iframe width="100%" height="100%" src="https://www.youtube.com/embed/Ktooso211wE" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen class="rounded-lg"></iframe>
        </div>
        <div class="text-center border-t border-gray-200 pt-4">
          <p class="font-semibold text-gray-800">Cliente Satisfecho</p>
          <p class="text-gray-600 text-sm">Video Testimonio de Nucleovital</p>
        </div>
      </div>

      <!-- Reseñas -->
      {testimonios.map((t) => (
        <div class="bg-gradient-to-br from-red-50 to-yellow-50 rounded-2xl p-8 shadow-lg flex flex-col justify-between">
          <div class="text-yellow-500 text-xl mb-4">★★★★★</div>
          <p class="text-gray-700 leading-relaxed mb-6">"{t.text}"</p>
          <div class="border-t border-gray-200 pt-4">
            <p class="font-semibold text-gray-800">{t.name}</p>
            <p class="text-gray-600 text-sm">{t.age}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>