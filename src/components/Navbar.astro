---
import logo from '../assets/logo.svg';
---
<header class="bg-white shadow-md sticky top-0 z-50">
  <div class="container mx-auto px-4 py-4 flex items-center justify-between">
    <a href="/">
      <img src={logo.src} alt="Nucleovital Logo" class="h-12 w-auto" />
    </a>
    <nav class="hidden md:flex space-x-6 text-gray-700 font-medium">
      <a href="#inicio" class="hover:text-red-600 transition-colors">Inicio</a>
      <a href="#producto" class="hover:text-red-600 transition-colors">Producto</a>
      <a href="#beneficios" class="hover:text-red-600 transition-colors">Beneficios</a>
    </nav>
  </div>
</header>