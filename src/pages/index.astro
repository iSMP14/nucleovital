---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Producto from '../components/Producto.astro';
import Beneficios from '../components/Beneficios.astro';
import Testimonios from '../components/Testimonios.astro';
import Sucursales from '../components/Sucursales.astro';
import Contacto from '../components/Contacto.astro';
---

<Layout title="NUCLEOVITAL Chile | Producto Farmacéutico para Bienestar y Salud">
  <Navbar />
  <main>
    <Hero />
    <Producto />
    <Beneficios />
    <Testimonios />
    <Sucursales />
    <Contacto />
  </main>
  
  <footer class="bg-gray-900 text-gray-400 py-8 text-center text-sm">
    <p>© {new Date().getFullYear()} NUCLEOVITAL Chile. Todos los derechos reservados.</p>
  </footer>
</Layout>