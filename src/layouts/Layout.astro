---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Nucleovital Chile | Multivitamínico Avanzado para tu Bienestar",
  description = "Descubre Nucleovital, el multivitamínico con Magnesio, Zinc y Colágeno que combate la fatiga y fortalece tu sistema inmune. Compra oficial en Chile."
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="multivitamínico, Nucleovital, vitaminas Chile, magnesio, zinc, sistema inmune, fatiga, colágeno" />
    <meta name="robots" content="index, follow" />
    
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/producto_1.png" />
    <meta property="og:site_name" content="Nucleovital Chile" />
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans antialiased pb-20 md:pb-0">
    <slot />
    
    <div class="fixed bottom-0 left-0 w-full p-4 bg-white/95 backdrop-blur-md border-t border-slate-200 shadow-[0_-10px_15px_-3px_rgba(0,0,0,0.05)] md:hidden z-100 transition-transform">
      <a 
        href="https://articulo.mercadolibre.cl/MLC-2932383734-nucleovital-_JM?has_official_store=false&highlight=false&headerTopBrand=false#polycard_client=search-nordic&search_layout=stack&position=8&type=item&tracking_id=e5ab2676-358d-4654-bf3f-7de7600f3dcd&wid=MLC2932383734&sid=search" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="flex w-full justify-center items-center gap-2 bg-yellow-500 hover:bg-yellow-600 text-slate-900 font-bold text-lg py-3.5 rounded-xl shadow-lg transition-colors"
      >
        Comprar en Mercado Libre ⚡
      </a>
    </div>
  </body>
</html>